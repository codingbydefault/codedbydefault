RESEND_API_KEY=re_xxxxxxxxx
QUICKSCAN_FROM_EMAIL=CodedByDefault <quickscan@mail.codedbydefault.com>

# Nieuw Supabase-project. Er is nog geen database aan deze site gekoppeld.
# De publishable key mag in de browser. De secret key nooit: geen NEXT_PUBLIC_-prefix.
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Komma-gescheiden. Alleen deze adressen kunnen /admin openen.
ADMIN_EMAILS=codedbydefault@gmail.com

# Lange willekeurige salt voor de dagelijkse bezoeker-hash. Minimaal 16 tekens.
# Genereren: openssl rand -base64 32
# Laat leeg tot je een eigen waarde hebt; een voorbeeldwaarde uit git wordt niet gebruikt.
ANALYTICS_SALT=
